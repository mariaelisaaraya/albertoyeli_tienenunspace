---
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import TranscriptViewer from "../../components/TranscriptViewer.tsx";
import { withBase } from "../../lib/url";

export async function getStaticPaths() {
  const episodes = await getCollection("episodes", (e) => !e.data.draft);
  return episodes.map((episode) => ({
    params: { slug: episode.id },
    props: { episode },
  }));
}

const { episode } = Astro.props;
const { Content } = await render(episode);
const data = episode.data;

const transcriptEntry = data.transcriptId ? await getEntry("transcripts", data.transcriptId) : undefined;
const segments = transcriptEntry?.data.segments ?? [];

const formattedDate = new Intl.DateTimeFormat("es-AR", {
  weekday: "long",
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "America/Argentina/Buenos_Aires",
}).format(data.date);

const canonicalUrl = new URL(withBase(`/episodios/${episode.id}/`), Astro.site).toString();
---

<BaseLayout title={data.title} description={data.summary} type="article">
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <p class="font-display text-sm font-bold uppercase tracking-widest text-coral">
      Episodio {data.number} · <span class="capitalize">{formattedDate}</span>
    </p>
    <h1 class="mt-2 font-display text-3xl font-extrabold leading-tight text-ink sm:text-4xl">
      {data.title}
    </h1>

    {
      data.guests.length > 0 && (
        <p class="mt-3 text-ink-soft">
          Con {data.guests.join(", ")}
        </p>
      )
    }

    {
      data.cover && (
        <Image
          src={data.cover}
          alt=""
          width={1200}
          height={675}
          class="mt-6 w-full rounded-doodle border-2 border-ink"
        />
      )
    }

    <div class="prose prose-lg mt-6 max-w-none text-ink-soft prose-headings:font-display prose-headings:text-ink prose-a:text-coral">
      <Content />
    </div>

    {
      data.highlights.length > 0 && (
        <div class="mt-8 rounded-doodle border-2 border-ink bg-sun-soft p-5">
          <h2 class="font-display text-lg font-bold text-ink">Ideas destacadas</h2>
          <ul class="mt-3 list-disc space-y-1.5 pl-5 text-ink-soft">
            {data.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="mt-8 flex flex-wrap items-center gap-3">
      {
        data.audioUrl && (
          <audio controls class="w-full rounded-full" id="episode-audio">
            <source src={withBase(data.audioUrl)} />
          </audio>
        )
      }
      {
        data.spaceUrl && (
          <a
            href={data.spaceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="focus-ring rounded-full border-2 border-ink bg-ink px-5 py-2.5 font-display font-bold text-paper"
          >
            Escuchar Space original en X
          </a>
        )
      }
    </div>

    {
      data.topics.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2">
          {data.topics.map((topic) => (
            <li class="rounded-full border border-ink/20 bg-sky-deep px-3 py-1 text-sm font-medium text-ink-soft">
              {topic}
            </li>
          ))}
        </ul>
      )
    }

    {
      data.links.length > 0 && (
        <div class="mt-8">
          <h2 class="font-display text-lg font-bold text-ink">Enlaces mencionados</h2>
          <ul class="mt-2 space-y-1">
            {data.links.map((link) => (
              <li>
                <a
                  href={link.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="focus-ring rounded font-medium text-ink underline decoration-coral decoration-2 underline-offset-4 hover:text-coral"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }

    <div class="mt-8">
      <ShareButtons title={data.title} url={canonicalUrl} />
    </div>

    <hr class="my-10 border-t-2 border-dashed border-ink/20" />

    <section>
      <h2 class="font-display text-2xl font-extrabold text-ink">Transcripción</h2>
      <div class="mt-5">
        <TranscriptViewer
          client:load
          segments={segments}
          status={data.transcriptStatus}
          hasAudio={Boolean(data.audioUrl)}
        />
      </div>
    </section>
  </article>
</BaseLayout>
