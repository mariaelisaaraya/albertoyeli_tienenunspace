---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EpisodesArchive, { type EpisodeSummary } from "../../components/EpisodesArchive.tsx";
import EmptyState from "../../components/EmptyState.astro";

const allEpisodes = (await getCollection("episodes"))
  .filter((e) => !e.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const summaries: EpisodeSummary[] = allEpisodes.map((e) => ({
  slug: e.id,
  number: e.data.number,
  title: e.data.title,
  summary: e.data.summary,
  date: e.data.date.toISOString(),
  topics: e.data.topics,
  guests: e.data.guests,
  durationMinutes: e.data.durationMinutes,
}));
---

<BaseLayout title="Episodios" description="Archivo completo de episodios de AlbertoYEli.">
  <section class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <h1 class="font-display text-4xl font-extrabold text-ink">Episodios</h1>
    <p class="mt-2 max-w-xl text-ink-soft">
      Todas las conversaciones de AlbertoYEli, de la más reciente a la más vieja.
    </p>

    {
      summaries.length === 0 ? (
        <div class="mt-10">
          <EmptyState
            title="El archivo está en construcción"
            description="Ya grabamos varios Spaces. Estamos preparando transcripciones y resúmenes antes de publicarlos acá — volvé pronto."
          />
        </div>
      ) : (
        <div class="mt-8">
          <EpisodesArchive client:load episodes={summaries} />
        </div>
      )
    }
  </section>
</BaseLayout>
