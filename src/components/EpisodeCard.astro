---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import { withBase } from "../lib/url";

interface Props {
  episode: CollectionEntry<"episodes">;
}

const { episode } = Astro.props;
const { number, title, date, summary, topics, durationMinutes, cover } = episode.data;

const formattedDate = new Intl.DateTimeFormat("es-AR", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "America/Argentina/Buenos_Aires",
}).format(date);
---

<article class="group flex flex-col overflow-hidden rounded-doodle border-2 border-ink bg-paper shadow-doodle-sm transition hover:-translate-y-1 hover:shadow-doodle">
  <a href={withBase(`/episodios/${episode.id}/`)} class="focus-ring block">
    {
      cover ? (
        <Image
          src={cover}
          alt=""
          width={640}
          height={360}
          class="aspect-video w-full border-b-2 border-ink object-cover"
        />
      ) : (
        <div class="flex aspect-video w-full items-center justify-center border-b-2 border-ink bg-sky-deep">
          <span class="font-display text-4xl font-extrabold text-ink/30">#{number}</span>
        </div>
      )
    }
  </a>
  <div class="flex flex-1 flex-col p-5">
    <p class="font-display text-xs font-bold uppercase tracking-widest text-coral">
      Episodio {number} · {formattedDate}
    </p>
    <h3 class="mt-2 font-display text-xl font-bold text-ink">
      <a href={withBase(`/episodios/${episode.id}/`)} class="focus-ring rounded hover:text-coral">
        {title}
      </a>
    </h3>
    <p class="mt-2 line-clamp-3 flex-1 text-sm text-ink-soft">{summary}</p>

    {
      topics.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {topics.slice(0, 3).map((topic) => (
            <li class="rounded-full border border-ink/20 bg-sky px-2.5 py-0.5 text-xs font-medium text-ink-soft">
              {topic}
            </li>
          ))}
        </ul>
      )
    }

    <div class="mt-4 flex items-center justify-between text-sm">
      {durationMinutes && <span class="text-ink-soft">{durationMinutes} min</span>}
      <a href={withBase(`/episodios/${episode.id}/`)} class="focus-ring ml-auto rounded font-bold text-ink hover:text-coral">
        Escuchar →
      </a>
    </div>
  </div>
</article>
