---
import { withBase } from "../lib/url";
import Waveform from "./Waveform.astro";
---

<section class="relative overflow-hidden px-4 pb-24 pt-14 sm:px-6 sm:pt-20">
  <!-- Puntitos de fondo, textura editorial sutil -->
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-40"
    style="background-image: radial-gradient(var(--color-ink) 1px, transparent 1px); background-size: 22px 22px;"
    aria-hidden="true"
  >
  </div>

  <div class="mx-auto max-w-5xl">
    <div
      class="inline-flex items-center gap-2 rounded-full border-2 border-ink bg-paper px-4 py-1.5 font-label text-xs font-bold uppercase tracking-[0.2em] text-ink"
    >
      <Waveform bars={5} class="h-3 w-6" color="var(--color-coral)" />
      88.2 · En vivo desde X Spaces
    </div>

    <h1
      class="mt-6 font-display text-[clamp(2.75rem,13vw,10.5rem)] leading-[0.82] tracking-tight text-ink"
    >
      Alberto<span class="text-coral">Y</span>Eli
    </h1>

    <div class="relative mt-8 grid gap-10 sm:mt-6 sm:grid-cols-12 sm:items-end">
      <div class="sm:col-span-7 sm:order-1">
        <p class="font-display text-2xl leading-tight text-ink sm:text-3xl md:text-4xl">
          Dos países. Dos micrófonos.
          <span class="relative inline-block">
            Cero guion.
            <svg
              class="absolute -bottom-2 left-0 w-full"
              viewBox="0 0 220 10"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path
                d="M2 7 Q 40 1, 80 6 T 160 5 T 218 7"
                fill="none"
                stroke="var(--color-coral)"
                stroke-width="5"
                stroke-linecap="round"
              />
            </svg>
          </span>
        </p>
        <p class="mt-5 max-w-sm text-ink-soft">
          Dos personas, muchas preguntas y conversaciones que valen la pena. Todos los viernes nos
          metemos en un X Space a hablar de tecnología, curiosidad y lo que se nos cruce, sin
          guion y sin solemnidad.
        </p>

        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href={withBase("/episodios")}
            class="focus-ring sketch-border border-[3px] border-ink bg-ink px-7 py-3.5 font-display text-sm text-paper shadow-doodle transition hover:-translate-y-0.5 hover:rotate-1 active:translate-y-0 active:shadow-none"
          >
            Escuchá los episodios
          </a>
          <a
            href={withBase("/proximo-space")}
            class="focus-ring sticker border-[3px] border-ink bg-sun px-7 py-3.5 font-display text-sm text-ink transition hover:-translate-y-0.5 hover:-rotate-1"
          >
            Sumate al próximo Space
          </a>
        </div>
      </div>

      <div class="relative sm:col-span-5 sm:order-2">
        <div
          class="animate-float mx-auto w-full max-w-[22rem] -rotate-3 sm:max-w-none"
          style="--tilt: -3deg"
        >
          <div class="relative">
            <svg
              class="absolute -inset-6 -z-10 text-sky-deep"
              viewBox="0 0 200 200"
              aria-hidden="true"
            >
              <path
                fill="currentColor"
                d="M44.7,-58.6C58.2,-50.5,69.4,-37.3,74.6,-21.8C79.7,-6.3,78.7,11.5,71.8,26.4C64.9,41.3,52,53.4,37.2,61.6C22.4,69.9,5.6,74.4,-11.4,74.1C-28.4,73.8,-45.6,68.6,-57.9,57.5C-70.2,46.4,-77.6,29.3,-79.4,11.3C-81.2,-6.7,-77.4,-25.6,-67.1,-40.1C-56.9,-54.6,-40.3,-64.7,-23.9,-71.6C-7.6,-78.6,8.5,-82.4,23.3,-77.8C38.1,-73.1,51.5,-60,44.7,-58.6Z"
                transform="translate(100 100)"
              />
            </svg>
            <img
              src={withBase("/images/hosts-illustration.png")}
              alt="Ilustración estilo doodle de Alberto y Eli, los conductores del podcast, sobre fondo celeste"
              class="relative w-full rounded-[2rem] border-[3px] border-ink"
              width="1774"
              height="887"
            />
            <span
              class="sticker absolute -right-5 -top-5 hidden rotate-6 border-[3px] border-ink bg-mint px-3 py-2 font-hand text-lg leading-none text-ink sm:inline-block"
            >
              ¡todos los viernes!
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
