---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<div class="sketch-border mx-auto flex max-w-md -rotate-1 flex-col items-center border-[3px] border-dashed border-ink/40 bg-paper px-6 py-14 text-center">
  <svg width="90" height="40" viewBox="0 0 90 40" aria-hidden="true" class="mb-4 text-ink/50">
    <line x1="2" y1="20" x2="88" y2="20" stroke="currentColor" stroke-width="2.5" stroke-dasharray="1 7" stroke-linecap="round" />
  </svg>
  <p class="font-label text-xs font-bold uppercase tracking-[0.2em] text-ink/50">· · · sintonizando · · ·</p>
  <h3 class="mt-3 font-display text-xl text-ink">{title}</h3>
  <p class="mt-2 max-w-xs text-sm text-ink-soft">{description}</p>
</div>
