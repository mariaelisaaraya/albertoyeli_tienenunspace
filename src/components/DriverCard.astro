---
import type { Host } from "../data/hosts";

interface Props {
  host: Host;
}

const { host } = Astro.props;
---

<article class="rounded-doodle border-2 border-ink bg-paper p-6 shadow-doodle-sm">
  <div class="flex items-start justify-between gap-3">
    <div>
      <h3 class="font-display text-2xl font-extrabold text-ink">{host.name}</h3>
      <p class="text-sm font-semibold text-ink-soft">{host.role} · {host.location}</p>
    </div>
    <a
      href={host.xUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="focus-ring shrink-0 rounded-full border-2 border-ink bg-sky-deep px-3 py-1.5 text-sm font-bold text-ink hover:bg-sun"
    >
      {host.xHandle}
    </a>
  </div>
  <p class="mt-4 text-ink-soft">{host.bio}</p>
  <a
    href={host.linkedinUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="focus-ring mt-4 inline-block text-sm font-semibold text-ink underline decoration-coral decoration-2 underline-offset-4 hover:text-coral"
  >
    Ver LinkedIn
  </a>
</article>
