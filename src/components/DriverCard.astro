---
import type { Host } from "../data/hosts";
import { withBase } from "../lib/url";

interface Props {
  host: Host;
  reverse?: boolean;
}

const { host, reverse = false } = Astro.props;
---

<article class={`flex flex-col gap-6 sm:flex-row sm:items-center ${reverse ? "sm:flex-row-reverse" : ""}`}>
  <div class="relative mx-auto w-40 shrink-0 sm:mx-0 sm:w-48">
    <div class={`absolute -inset-3 -z-10 rounded-full bg-sky-deep ${reverse ? "rotate-6" : "-rotate-6"}`} aria-hidden="true"></div>
    <img
      src={withBase(host.portrait)}
      alt={`Retrato ilustrado de ${host.name}`}
      width="200"
      height="200"
      class="w-full rounded-full border-[3px] border-ink object-cover"
    />
  </div>

  <div class="min-w-0 flex-1 text-center sm:text-left">
    <div class={`flex flex-wrap items-center justify-center gap-3 sm:justify-start`}>
      <h3 class="font-display text-4xl text-ink sm:text-5xl">{host.name}</h3>
      <a
        href={host.xUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="focus-ring rounded-full border-2 border-ink bg-sky-deep px-3 py-1 font-label text-sm font-bold text-ink hover:bg-sun"
      >
        {host.xHandle}
      </a>
    </div>
    <p class="mt-1 font-label text-sm font-bold uppercase tracking-widest text-coral">
      {host.role} · {host.location}
    </p>
    <p class="mx-auto mt-3 max-w-md text-ink-soft sm:mx-0">{host.shortBio}</p>

    <div class="mt-4 flex flex-wrap justify-center gap-4 sm:justify-start">
      <a
        href={withBase(`/conducen/${host.slug}/`)}
        class="focus-ring font-display text-sm text-ink underline decoration-coral decoration-2 underline-offset-4 hover:text-coral"
      >
        Leer bio completa →
      </a>
      <a
        href={host.linkedinUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="focus-ring font-display text-sm text-ink-soft underline decoration-ink/30 decoration-2 underline-offset-4 hover:text-coral"
      >
        LinkedIn
      </a>
    </div>
  </div>
</article>
