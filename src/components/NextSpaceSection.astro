---
import NextSpace from "./NextSpace.tsx";
import { getNextSpace } from "../lib/time";
import { buildGoogleCalendarUrl } from "../lib/calendar";
import { DISPLAY_TIMEZONES } from "../data/schedule";
import { withBase } from "../lib/url";

const next = getNextSpace();
const googleCalendarUrl = buildGoogleCalendarUrl(next);
---

<NextSpace
  client:load
  instantISO={next.instant.toISOString()}
  spaceUrl={next.confirmed?.spaceUrl}
  displayTimezones={DISPLAY_TIMEZONES}
  googleCalendarUrl={googleCalendarUrl}
  icsUrl={withBase("/calendar/proximo-space.ics")}
/>
