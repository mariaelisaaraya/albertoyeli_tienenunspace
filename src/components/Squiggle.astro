---
interface Props {
  class?: string;
  color?: string;
}
const { class: className = "", color = "var(--color-ink)" } = Astro.props;
---

<svg
  viewBox="0 0 300 16"
  preserveAspectRatio="none"
  class={`h-3 w-full ${className}`}
  aria-hidden="true"
>
  <path
    d="M0 8 Q 15 0, 30 8 T 60 8 T 90 8 T 120 8 T 150 8 T 180 8 T 210 8 T 240 8 T 270 8 T 300 8"
    fill="none"
    stroke={color}
    stroke-width="3"
    stroke-linecap="round"
  />
</svg>
