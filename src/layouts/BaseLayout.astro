---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/url";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Ruta absoluta dentro del sitio para la imagen OG (ej: "/images/og-default.png"). */
  ogImage?: string;
  type?: "website" | "article";
}

const {
  title,
  description = "AlbertoYEli: conversaciones semanales en X Spaces sobre tecnología, curiosidad y lo que se nos ocurra. Todos los viernes.",
  ogImage = withBase("/images/hosts-illustration.png"),
  type = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site);
const fullTitle = title === "AlbertoYEli" ? title : `${title} · AlbertoYEli`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link id="site-favicon" rel="icon" type="image/png" href={withBase("/images/eli-portrait.png")} data-eli={withBase("/images/eli-portrait.png")} data-alberto={withBase("/images/alberto-portrait.png")} />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content="AlbertoYEli" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;600;700&family=Caveat:wght@500;600;700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link rel="alternate" type="application/rss+xml" title="AlbertoYEli" href={withBase("/rss.xml")} />
  </head>
  <body class="flex min-h-screen flex-col font-sans antialiased">
    <script>
      import "../lib/language-switcher";
      const favicon = document.querySelector<HTMLLinkElement>("#site-favicon");
      if (favicon && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const portraits = [favicon.dataset.eli!, favicon.dataset.alberto!];
        let index = 0;
        window.setInterval(() => {
          index = (index + 1) % portraits.length;
          favicon.href = portraits[index];
        }, 4000);
      }
    </script>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-ink focus:px-4 focus:py-2 focus:text-paper"
    >
      Saltar al contenido
    </a>
    <Header />
    <main id="contenido" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
